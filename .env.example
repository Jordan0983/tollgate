# Receiving wallet (Solana address). Generate with `npm run wallets`.
PAY_TO=

# devnet (default) or mainnet. The default facilitator below is TESTNET/DEVNET ONLY.
NETWORK=devnet
FACILITATOR_URL=https://x402.org/facilitator

# Optional: a Helius/QuickNode RPC URL. Speeds up payments slightly.
RPC_URL=

# Protects /tollgate and /tollgate/api/stats. Use a long random string. Required for any public deploy.
DASHBOARD_TOKEN=

# Optional: refuse a wallet after it has paid this much in one UTC day.
MAX_PER_PAYER_PER_DAY_USD=0.50

PORT=3000
LEDGER_FILE=data/ledger.json
